# Server Configuration
PORT=3001
NODE_ENV=development

# Desktop SSH Configuration
DESKTOP_SSH_HOST=192.168.1.100
DESKTOP_SSH_PORT=22
DESKTOP_SSH_USER=yourusername
DESKTOP_SSH_PASSWORD=yourpassword
# OR use key-based authentication (recommended)
# DESKTOP_SSH_PRIVATE_KEY_PATH=/path/to/private/key

# Weather API Configuration
WEATHER_API_KEY=your_weatherapi_com_key
WEATHER_LOCATION=New York
WEATHER_UNITS=imperial

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Calendar OAuth Configuration (Optional)
# Get these credentials from https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing
# 2. Enable Google Calendar API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URIs: http://localhost:3001/api/calendar/oauth2callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth2callback
