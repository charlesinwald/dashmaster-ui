{
  "name": "dashmaster-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"yarn dev:next\" \"yarn dev:server\"",
    "dev:next": "NODE_OPTIONS='--no-warnings' next dev",
    "dev:server": "nodemon --watch server --ext ts,json --exec ts-node --project tsconfig.server.json server/index.ts",
    "build": "next build",
    "start": "concurrently \"yarn start:next\" \"yarn start:server\"",
    "start:next": "next start",
    "start:server": "ts-node --project tsconfig.server.json server/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^167.0.0",
    "lucide-react": "^0.555.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-grid-layout": "^1.5.2",
    "react-resizable": "^3.0.5",
    "ssh2": "^1.17.0",
    "tw-animate-css": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "@types/ssh2": "^1.15.5",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
